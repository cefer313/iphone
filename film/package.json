{
  "name": "the-weight-of-compassion",
  "version": "1.0.0",
  "private": true,
  "description": "30-second vertical animated short film built with Remotion",
  "scripts": {
    "assets": "python3 scripts/make_timeline.py && python3 scripts/make_textures.py && python3 scripts/make_audio.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts WeightOfCompassion out/the-weight-of-compassion.mp4 --codec=h264 --pixel-format=yuv420p --crf=18 --browser-executable=/opt/pw-browsers/chromium"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.399",
    "@remotion/cli": "^4.0.399",
    "@remotion/renderer": "^4.0.399",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.399",
    "typescript": "^5.6.3"
  }
}
