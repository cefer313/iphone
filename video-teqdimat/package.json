{
  "name": "video-teqdimat",
  "version": "1.0.0",
  "private": true,
  "description": "Çəkiliş, məzmun yaradılması və montaj xidmətləri üçün 9:16 video təqdimat (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Teqdimat out/teqdimat.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.1",
    "@fontsource/montserrat": "5.1.1",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
